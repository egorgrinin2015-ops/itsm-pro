  "repository": {
    "type": "git",
    "url": "https://github.com/egorgrinin2015-ops/itsm-pro.git"
  },
  "keywords": [
    "itsm",
    "helpdesk",
    "ticketing",
    "it-service-management",
    "react",
    "nodejs",
    "postgresql"
  ],
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
