{
  "name": "itsm-backend",
  "version": "1.0.0",
  "description": "ITSM System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "npx sequelize-cli db:migrate:undo:all",
    "db:import": "node import-db.js",
    "db:create": "npx sequelize-cli db:create",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "itsm",
    "tickets",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.1"
  }
}
